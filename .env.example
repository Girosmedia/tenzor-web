# Resend — envío del formulario de contacto (app/api/contact/route.ts).
# Sin esta key, el formulario responde con un error legible en vez de enviar.
RESEND_API_KEY=

# Umami — analítica autohospedada (app/layout.tsx). Si cualquiera de las
# dos falta, el script de Umami simplemente no se emite.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
